# Мозг: локальная модель Ollama (обязательно поддерживает tool calling)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_MS=180000

# Google Drive: OAuth-подключение (рекомендуется) — см. agent/README.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:4321/oauth2callback

# Альтернатива: сервисный аккаунт с domain-wide delegation
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# GOOGLE_IMPERSONATE=owner@example.com

# Структура в Drive (ID можно не менять — это рабочее пространство агента)
DRIVE_WORKSPACE_FOLDER_ID=1txbPb1oZfEijx67rDzgadeVgTzjPwZdg
DRIVE_TASKS_SHEET_ID=1pchl2sUyXToxJsme6246Kgv1w0vMl2cAHItEIEppLDA
# DRIVE_REPORTS_FOLDER_ID=1hP1gKSpPswZBL_FGiwwgXz2m4zXlaIn6

# Поиск в интернете: duckduckgo (без ключа), tavily или brave
WEB_SEARCH_PROVIDER=duckduckgo
# TAVILY_API_KEY=
# BRAVE_API_KEY=
WEB_TIMEOUT_MS=15000
WEB_MAX_CHARS=12000

# Ограничения агента
AGENT_MAX_STEPS=14
AGENT_MAX_WRITE_OPS=5
AGENT_POLL_INTERVAL_MS=900000
AGENT_STATE_FILE=.agent-state/processed.json
# AGENT_DRY_RUN=1
# AGENT_ALLOW_DANGEROUS=1   # НЕ включайте для автономной работы
